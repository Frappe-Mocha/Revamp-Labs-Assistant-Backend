{
    "workflow_id": "create_new_company",
    "title": "Create a New Company in HubSpot CRM",
    "description": "This workflow navigates to the Companies section in HubSpot CRM and creates a new company record with domain, name, industry, and other business information.",
    "steps": [
      {
        "step_id": "open_companies",
        "description": "Open the Companies section",
        "action": "click",
        "element": {
          "identifier": "data-test-id",
          "value": "companies",
          "element_type": "link"
        }
      },
      {
        "step_id": "create_new_company",
        "description": "Click the Create Company button",
        "action": "click",
        "element": {
          "identifier": "data-test-id",
          "value": "new-object-button",
          "element_type": "button"
        }
      },
      {
        "step_id": "enter_domain",
        "description": "Enter company domain",
        "action": "fill",
        "element": {
          "identifier": "data-test-id",
          "value": "domain-input",
          "element_type": "input",
          "in_iframe": "object-builder-ui-iframe"
        },
        "input_value": "apli.ai"
      },
      {
        "step_id": "click_name_field",
        "description": "Click the company name field",
        "action": "click",
        "element": {
